<?xml version="1.0"?>
<package format="3">
  <name>smartfarm_inspector</name>
  <version>0.2.0</version>
  <description>
    Smart Farm Asset Inspector. Turns a farmer's natural-language inspection
    request into a validated navigation_interfaces/MissionData and hands it to
    the existing Eagle navigation stack.
  </description>
  <maintainer email="team@example.com">Smart Farm Team</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>navigation_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
